# Maintainer: false-comm contributors <thuanc177@gmail.com>
pkgname=false-comm-git
pkgver=2.0.0.r0.g1234567
pkgrel=1
pkgdesc="Realistic, stealth Git commit history synthesizer for developers (git development version)"
arch=('any')
url="https://github.com/AtelierMizumi/false-comm"
license=('MIT')
depends=(
    'git'
    'python>=3.12'
    'python-pydantic'
    'python-yaml'
    'python-rich'
    'python-typer'
)
makedepends=(
    'git'
    'python-build'
    'python-installer'
    'python-wheel'
    'python-hatchling'
)
checkdepends=(
    'python-pytest'
    'python-hypothesis'
)
provides=('false-comm')
conflicts=('false-comm')
source=("${pkgname}::git+https://github.com/AtelierMizumi/false-comm.git")
sha256sums=('SKIP')

pkgver() {
    cd "${pkgname}"
    git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' || \
    printf "2.0.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    cd "${pkgname}"
    python -m build --wheel --no-isolation
}

check() {
    cd "${pkgname}"
    python -m pytest tests/unit
}

package() {
    cd "${pkgname}"
    python -m installer --destdir="${pkgdir}" dist/*.whl

    # License and documentation
    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"

    # Shell completions
    if [ -d "packaging/completions" ]; then
        install -Dm644 packaging/completions/bash "${pkgdir}/usr/share/bash-completion/completions/false-comm"
        install -Dm644 packaging/completions/bash "${pkgdir}/usr/share/bash-completion/completions/fc"
        install -Dm644 packaging/completions/zsh "${pkgdir}/usr/share/zsh/site-functions/_false-comm"
        install -Dm644 packaging/completions/zsh "${pkgdir}/usr/share/zsh/site-functions/_fc"
        install -Dm644 packaging/completions/fish "${pkgdir}/usr/share/fish/vendor_completions.d/false-comm.fish"
        install -Dm644 packaging/completions/fish "${pkgdir}/usr/share/fish/vendor_completions.d/fc.fish"
    fi

    # Man page
    if [ -f "packaging/man/false-comm.1" ]; then
        install -Dm644 packaging/man/false-comm.1 "${pkgdir}/usr/share/man/man1/false-comm.1"
    fi
}
