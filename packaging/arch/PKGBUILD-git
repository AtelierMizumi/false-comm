# Maintainer: false-comm contributors <thuanc177@gmail.com>
pkgname=false-comm-git
pkgver=2.0.0.r0.g1234567
pkgrel=1
pkgdesc="Realistic, stealth Git commit history synthesizer for developers (git development version)"
arch=('any')
url="https://github.com/AtelierMizumi/false-comm"
license=('MIT')
depends=(
    'python>=3.12'
    'python-pydantic'
    'python-yaml'
    'python-rich'
    'python-typer'
    'git'
)
makedepends=(
    'git'
    'python-build'
    'python-installer'
    'python-wheel'
    'python-hatchling'
)
provides=('false-comm')
conflicts=('false-comm')
source=("${pkgname}::git+https://github.com/AtelierMizumi/false-comm.git")
sha256sums=('SKIP')

pkgver() {
    cd "${pkgname}"
    git describe --long --tags --abbrev=7 2>/dev/null | sed 's/^v//;s/\([^-]*-g\)/r\1/;s/-/./g' || \
    printf "2.0.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    cd "${pkgname}"
    python -m build --wheel --no-isolation
}

package() {
    cd "${pkgname}"
    python -m installer --destdir="${pkgdir}" dist/*.whl

    install -Dm644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"
    install -Dm644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"
}
