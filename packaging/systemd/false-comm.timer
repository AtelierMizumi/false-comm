[Unit]
Description=Timer for false-comm automated developer commit maintenance
Documentation=https://github.com/AtelierMizumi/false-comm

[Timer]
# Run on weekdays at 10:24 and 15:47 with 15min random delay
OnCalendar=Mon..Fri 10:24:00
OnCalendar=Mon..Fri 15:47:00
RandomizedDelaySec=900
Persistent=true

[Install]
WantedBy=timers.target
